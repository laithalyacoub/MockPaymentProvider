              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"transactionId\": \"{{idemId}}\", \"mobileNumber\": \"0791234567\", \"amount\": 5}"
            },
            "description": "Scenario 20 (an expired token) is manual: set Security:TokenLifetimeSeconds to 10, wait 11 seconds, then send this request with the old token."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"idemId\", \"TXN-\" + Date.now().toString().slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SUCCESS with reference\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"SUCCESS\");",
                  "  pm.environment.set(\"idemRef\", body.paymentReference);",
                  "});"
                ]
              }
            }
          ]
