{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "MockPaymentProvider" },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=MockPaymentProviderDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Security": {
    "ApiKey": "",
    "ClientId": "",
    "ClientSecret": "",
    "JwtSigningKey": "",
    "Issuer": "mock-payment-provider",
    "Audience": "zain-recharge-api",
    "TokenLifetimeSeconds": 300
  },
  "Simulation": {
    "MaxSuccessAmount": 20,
    "OutageMobileNumber": "0790000000",
    "SlowMobileNumber": "0799999999",
    "SlowDelaySeconds": 10
  },
  "AllowedHosts": "*"
}
